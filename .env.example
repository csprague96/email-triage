# ---- Required ----
# TypeSafe (Jev) API key. Get one at https://console.typesafe.ai/
TYPESAFE_API_KEY=

# OpenAI API key, used only to write reply drafts. Leave blank to disable drafting.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# ---- Mail backend ----
# outlook  = classic Outlook desktop on Windows (no extra setup, default)
# graph    = Microsoft Graph API (works anywhere, needs an app registration, see README)
MAIL_BACKEND=outlook

# Only for MAIL_BACKEND=graph
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=common

# ---- Behaviour ----
# Comma-separated priorities that get a reply drafted automatically
DRAFT_FOR_PRIORITIES=urgent,high
# Write "Priority: X" and tag names onto the email as Outlook categories
APPLY_OUTLOOK_CATEGORIES=true
# Seconds between inbox checks when running the watcher
POLL_SECONDS=120
# Dashboard port
PORT=8765
# Show a Windows toast when a draft is ready
TOAST_NOTIFICATIONS=true

# ---- Team features ----
# Shared tag set: an https URL (e.g. the raw tags.json in your GitHub repo) or a file/UNC path.
# Shared tags are merged with your local ones and shown read-only. Blank = local tags only.
SHARED_TAGS_SOURCE=
SHARED_TAGS_REFRESH_HOURS=6

# Daily digest to Slack. Create an Incoming Webhook at https://api.slack.com/messaging/webhooks
# Blank = no digest. Only subjects, sender names and tags are sent, never bodies.
SLACK_WEBHOOK_URL=
DIGEST_TIME=08:00
DIGEST_WEEKDAYS_ONLY=true
DIGEST_LOOKBACK_HOURS=24
